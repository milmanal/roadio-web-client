# Backend the Vite dev proxy forwards /api/* to.
# Prod backend is live on Heroku; point here for real data (HTTP Basic auth).
BACKEND_URL=https://roadio-revive-ede3dca3face.herokuapp.com

# To run against a LOCAL Flask backend instead, use a non-5000 port — macOS
# AirPlay Receiver squats on :5000 and returns 403. e.g. http://localhost:5050

# HTTP Basic credentials injected by the dev proxy (kept server-side, never bundled).
BACKEND_BASIC_USER=shinom
BACKEND_BASIC_PASS=iloveToRide

# Mapbox GL JS token (GeoGuess card / live map). https://account.mapbox.com
VITE_MAPBOX_TOKEN=
